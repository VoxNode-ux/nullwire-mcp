#!/usr/bin/env bash
# gh nullwire: run NullWire-MCP through the GitHub CLI.
#
#   gh extension install VoxNode-ux/gh-nullwire
#   gh nullwire scan --discover
#   gh nullwire install --client all
#
# On first use it downloads the binary for this machine with `gh release
# download` (so your gh login and proxy settings apply), checks it against the
# release's SHA256SUMS.txt, and caches it. Set NULLWIRE_VERSION to pin a tag.
set -euo pipefail

REPO="VoxNode-ux/nullwire-mcp"

die() { printf 'gh nullwire: %s\n' "$*" >&2; exit 1; }

case "$(uname -s)" in
  Linux) os=linux ;;
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *) die "unsupported operating system: $(uname -s)" ;;
esac
case "$(uname -m)" in
  x86_64|amd64) arch=amd64 ;;
  aarch64|arm64) arch=arm64 ;;
  *) die "unsupported CPU: $(uname -m)" ;;
esac
[ "$os" = windows ] && arch=amd64   # Windows on ARM runs the x64 build
asset="nullwire-$os-$arch"
[ "$os" = windows ] && asset="$asset.exe"

tag="${NULLWIRE_VERSION:-}"
if [ -z "$tag" ]; then
  tag=$(gh release view --repo "$REPO" --json tagName --jq .tagName) || die "could not look up the latest release"
fi
case "$tag" in v[0-9]*.[0-9]*.[0-9]*|latest) ;; *) die "unexpected release tag: $tag" ;; esac

cache="${XDG_CACHE_HOME:-$HOME/.cache}/gh-nullwire/$tag"
bin="$cache/$asset"

if [ ! -x "$bin" ]; then
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  gh release download "$tag" --repo "$REPO" --pattern "$asset" --pattern SHA256SUMS.txt --dir "$tmp" \
    || die "download failed for $tag"
  want=$(awk -v f="$asset" '$2 == f || $2 == "*" f { print $1; exit }' "$tmp/SHA256SUMS.txt")
  [ -n "$want" ] || die "SHA256SUMS.txt has no entry for $asset"
  if command -v sha256sum >/dev/null 2>&1; then
    got=$(sha256sum "$tmp/$asset" | awk '{ print $1 }')
  else
    got=$(shasum -a 256 "$tmp/$asset" | awk '{ print $1 }')
  fi
  [ "$got" = "$want" ] || die "checksum mismatch for $asset; not running it"
  mkdir -p "$cache"
  install -m 0755 "$tmp/$asset" "$bin"
  trap - EXIT
  rm -rf "$tmp"
fi

exec "$bin" "$@"
