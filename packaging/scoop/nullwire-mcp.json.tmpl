  "homepage": "https://github.com/VoxNode-ux/nullwire-mcp",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/VoxNode-ux/nullwire-mcp/releases/download/@@TAG@@/nullwire-windows-amd64.exe#/nullwire-mcp.exe",
      "hash": "@@SHA_WINDOWS_AMD64@@"
    },
    "arm64": {
      "url": "https://github.com/VoxNode-ux/nullwire-mcp/releases/download/@@TAG@@/nullwire-windows-arm64.exe#/nullwire-mcp.exe",
      "hash": "@@SHA_WINDOWS_ARM64@@"
    }
  },
  "bin": "nullwire-mcp.exe",
  "checkver": {
    "github": "https://github.com/VoxNode-ux/nullwire-mcp",
    "regex": "/releases/tag/v([\\d.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/VoxNode-ux/nullwire-mcp/releases/download/v$version/nullwire-windows-amd64.exe#/nullwire-mcp.exe",
        "hash": {
          "url": "https://github.com/VoxNode-ux/nullwire-mcp/releases/download/v$version/SHA256SUMS.txt",
          "regex": "$sha256\\s+nullwire-windows-amd64\\.exe"
        }
      },
      "arm64": {
        "url": "https://github.com/VoxNode-ux/nullwire-mcp/releases/download/v$version/nullwire-windows-arm64.exe#/nullwire-mcp.exe",
        "hash": {
          "url": "https://github.com/VoxNode-ux/nullwire-mcp/releases/download/v$version/SHA256SUMS.txt",
          "regex": "$sha256\\s+nullwire-windows-arm64\\.exe"
        }
      }
    }
  },
  "notes": "Register with your MCP clients: nullwire-mcp install --client all. Remove the entries before uninstalling: nullwire-mcp install --uninstall --client all"
}
